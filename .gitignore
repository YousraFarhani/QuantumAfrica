# The admin password and session key. Never commit this.
.env.admin
.env

# Local databases — the site content lives in public/data/content.json,
# which IS committed; these are working files.
backend/data/*.sqlite3
backend/data/*.sqlite3-*
*.sqlite3

# Backend local export: the admin server writes here, then publish.py copies
# from backend/public/ → repo public/ during publish. The export working dir
# should never be committed on its own.
backend/public/
backend/data/content.sqlite3

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and operating systems
.DS_Store
Thumbs.db
.vscode/
.idea/

# Netlify
.netlify/
